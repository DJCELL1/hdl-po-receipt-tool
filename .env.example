# HDL PO Receipt Tool - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hdl_receipts
POSTGRES_USER=hdl_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=hdl_receipts

# Cin7 Omni API Configuration
CIN7_API_BASE_URL=https://api.cin7.com/api
CIN7_API_KEY=your_cin7_api_key_here
CIN7_API_SECRET=your_cin7_api_secret_here

# Rate Limiting (requests per period)
CIN7_RATE_LIMIT_PER_SECOND=3
CIN7_RATE_LIMIT_PER_MINUTE=60
CIN7_RATE_LIMIT_PER_DAY=5000

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
# For Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# For Mac: /usr/local/bin/tesseract

# Fuzzy Matching Threshold (0-100)
FUZZY_MATCH_THRESHOLD=85
